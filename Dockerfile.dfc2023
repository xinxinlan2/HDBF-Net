FROM pytorch/pytorch:2.0.1-cuda11.7-cudnn8-runtime

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1

RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu/|https://mirrors.tuna.tsinghua.edu.cn/ubuntu/|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    vim htop screen git wget curl unzip \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    openssh-server sudo ca-certificates \
    && mkdir -p /run/sshd /var/run/sshd \
    && ssh-keygen -A \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/HDBF-Net

COPY requirements_dfc2023.txt .
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --upgrade "pip==23.3.2" "setuptools==68.2.2" "wheel==0.41.2" && \
    pip install -r requirements_dfc2023.txt

COPY . .

RUN python -c "import torch, torchvision, rasterio, timm, mmcv, cv2; print('torch', torch.__version__, 'cuda', torch.version.cuda); print('HDBF dependencies ok')"

CMD ["/bin/bash"]
